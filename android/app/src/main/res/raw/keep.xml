<?xml version="1.0" encoding="utf-8"?>
<!-- The notification icon is looked up by name at runtime (flutter_local_notifications), which
     the resource shrinker can't see, so tell it to keep the file in release builds. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_notification,@color/notification_color" />
